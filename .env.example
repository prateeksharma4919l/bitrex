# Local development database. Copy this file to .env and replace the placeholder
# with a local-only password (use URL-safe letters and numbers).
POSTGRES_USER="bitrex"
POSTGRES_PASSWORD="REPLACE_WITH_A_LOCAL_ONLY_PASSWORD"
POSTGRES_DB="bitrex"
DATABASE_URL="postgresql://bitrex:REPLACE_WITH_A_LOCAL_ONLY_PASSWORD@localhost:5433/bitrex?schema=public"
APP_MODE="DEMO"
APP_URL="http://localhost:3000"
# Optional provider adapters (server-side only)
# Indicative market data; defaults to CoinPaprika's public API.
PRICE_PROVIDER_NAME="CoinPaprika"
PRICE_PROVIDER_URL=""
PRICE_PROVIDER_API_KEY=""
ONRAMP_PROVIDER_URL=""
ONRAMP_PROVIDER_API_KEY=""
WALLET_PROVIDER_URL=""
WALLET_PROVIDER_API_KEY=""
BLOCKCHAIN_RPC_URL=""
EMAIL_PROVIDER_URL=""
EMAIL_PROVIDER_API_KEY=""
SWAP_PROVIDER_URL=""
SWAP_PROVIDER_API_KEY=""
