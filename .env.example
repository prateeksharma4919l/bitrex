# Demo mode runs without providers or a database. Configure a managed PostgreSQL URL for persistence.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bitrex?sslmode=require"
APP_MODE="DEMO"
APP_URL="http://localhost:3000"
# Optional provider adapters (server-side only)
PRICE_PROVIDER_URL=""
PRICE_PROVIDER_API_KEY=""
ONRAMP_PROVIDER_URL=""
ONRAMP_PROVIDER_API_KEY=""
WALLET_PROVIDER_URL=""
WALLET_PROVIDER_API_KEY=""
BLOCKCHAIN_RPC_URL=""
EMAIL_PROVIDER_URL=""
EMAIL_PROVIDER_API_KEY=""
SWAP_PROVIDER_URL=""
SWAP_PROVIDER_API_KEY=""
